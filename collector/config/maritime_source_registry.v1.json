{
  "version": "1.1",
  "domain": "AGROLOG_MARITIME_INTELLIGENCE",
  "purpose": "canonical_registry_for_maritime_collection_and_evidence_governance",
  "rules": {
    "preserve_current_collectors": true,
    "raw_before_normalization": true,
    "single_ais_message_never_confirms_physical_state": true,
    "programming_is_not_realized": true,
    "licensed_or_authorized_hydrography_only": true,
    "secrets_must_not_be_stored_in_git": true,
    "runtime_source_must_declare_freshness_and_health": true,
    "source_failure_must_not_be_hidden_by_synthetic_substitution": true,
    "weather_does_not_imply_port_restriction_without_authorized_rule": true,
    "aggregate_trade_data_never_implies_vessel_level_cargo": true
  },
  "sources": [
    {
      "source_id": "aisstream_live",
      "kind": "live_stream",
      "provider": "AISStream",
      "role": ["AIS_POSITION", "AIS_STATIC_IDENTITY"],
      "collection_mode": "WEBSOCKET",
      "evidence_class": "OBSERVADO",
      "credential_class": "SECRET_MANAGER_ONLY",
      "raw_required": true,
      "checkpoint_semantics": "LOGICAL_CHECKPOINT_ONLY_NO_UPSTREAM_REPLAY",
      "health_required": ["heartbeat", "retry", "reconnect", "checkpoint", "deduplication"],
      "runtime_status": "CREDENTIAL_GATED"
    },
    {
      "source_id": "pyais_decoder",
      "kind": "decoder_library",
      "provider": "pyais",
      "role": ["AIS_DECODING", "AIS_VALIDATION_SUPPORT"],
      "collection_mode": "LIBRARY",
      "evidence_class": "DERIVED_FROM_SOURCE",
      "credential_class": "NONE",
      "raw_required": false,
      "runtime_status": "REFERENCE_CORE"
    },
    {
      "source_id": "antaq_estatistico_aquaviario",
      "kind": "official_dataset_family",
      "provider": "ANTAQ",
      "url": "https://www.gov.br/antaq/pt-br/central-de-conteudos/paineis/documentos_paineis/estatistico_aquaviario",
      "role": ["PORT_MOVEMENT", "CARGO_FLOW", "TERMINAL_STATISTICS"],
      "collection_mode": "OFFICIAL_DOWNLOAD",
      "expected_frequency": "MONTHLY",
      "evidence_class": "OBSERVADO",
      "credential_class": "NONE",
      "raw_required": true,
      "runtime_status": "REGISTERED_ADAPTER_PENDING",
      "vessel_level_attribution_allowed": false
    },
    {
      "source_id": "official_lineups",
      "kind": "official_operational_sources",
      "provider": "PORT_AUTHORITIES",
      "role": ["LINEUP", "ETA_INFORMED", "BERTH_PROGRAMMING", "PORT_CALL_EVIDENCE"],
      "collection_mode": "HTML_PDF_API_PER_PORT",
      "evidence_class": "INFORMADO",
      "credential_class": "NONE_UNLESS_SOURCE_REQUIRES",
      "raw_required": true,
      "runtime_status": "PARTIAL_FIVE_PORT_PILOT",
      "registry_ref": "collector/config/maritime_lineup_sources.v1.json"
    },
    {
      "source_id": "official_port_terminals",
      "kind": "official_reference_family",
      "provider": "PORT_AUTHORITIES_AND_TERMINALS",
      "role": ["PORT_REFERENCE", "TERMINAL_REFERENCE", "BERTH_REFERENCE", "OPERATIONAL_EVENTS"],
      "collection_mode": "OFFICIAL_PAGES_DATASETS_AND_AUTHORIZED_FEEDS",
      "evidence_class": "OBSERVADO_OR_INFORMADO",
      "credential_class": "SOURCE_SPECIFIC",
      "raw_required": true,
      "runtime_status": "INCREMENTAL"
    },
    {
      "source_id": "comexstat_trade",
      "kind": "official_trade_dataset",
      "provider": "MDIC_COMEX_STAT",
      "role": ["FOREIGN_TRADE_FLOW", "PRODUCT", "VALUE", "MASS", "FISCAL_GEOGRAPHY"],
      "collection_mode": "OFFICIAL_API_AND_FILES",
      "evidence_class": "OBSERVADO",
      "credential_class": "NONE_OR_OFFICIAL_CREDENTIAL",
      "raw_required": true,
      "runtime_status": "SHARED_AGROLOG_SOURCE",
      "vessel_level_attribution_allowed": false
    },
    {
      "source_id": "chm_pnboia",
      "kind": "official_ocean_observation",
      "provider": "MARINHA_DO_BRASIL_CHM_PNBOIA",
      "url": "https://www.marinha.mil.br/chm/dados-do-goos-brasil/pnboia",
      "role": ["WIND", "WAVES", "SEA_TEMPERATURE", "CURRENTS", "PRESSURE", "OCEAN_OBSERVATION"],
      "collection_mode": "OFFICIAL_PUBLIC_DATA_SURFACE",
      "evidence_class": "OBSERVADO",
      "credential_class": "NONE_OR_REQUEST_DEPENDING_PRODUCT",
      "raw_required": true,
      "runtime_status": "SOURCE_CONTRACT_DISCOVERY",
      "operational_restriction_claim_allowed": false
    },
    {
      "source_id": "chm_meteocean_forecast",
      "kind": "official_meteocean_forecast",
      "provider": "MARINHA_DO_BRASIL_CHM_SMM",
      "url": "https://www.marinha.mil.br/chm/dados-do-smm-previsao-oceanografica/previsao-meteoceanografica",
      "role": ["WIND_FORECAST", "WAVE_FORECAST", "MARINE_WEATHER_WARNING"],
      "collection_mode": "OFFICIAL_BULLETIN",
      "expected_frequency": "DAILY",
      "evidence_class": "PROJETADO_OR_INFORMADO",
      "credential_class": "NONE",
      "raw_required": true,
      "runtime_status": "ADAPTER_PENDING",
      "forecast_horizon_hours": 48,
      "operational_restriction_claim_allowed": false
    },
    {
      "source_id": "chm_bndo_authorized_data",
      "kind": "authorized_hydrographic_oceanographic_family",
      "provider": "MARINHA_DO_BRASIL_CHM_BNDO",
      "url": "https://www.marinha.mil.br/chm/bndo/acesso",
      "role": ["TIDE", "CURRENT", "METEOROLOGY", "BATHYMETRY_REFERENCE", "HYDROGRAPHIC_QA"],
      "collection_mode": "PUBLIC_DOWNLOAD_OR_FORMAL_REQUEST",
      "evidence_class": "OBSERVADO",
      "credential_class": "LICENSE_OR_AUTHORIZATION_WHEN_REQUIRED",
      "raw_required": true,
      "runtime_status": "RIGHTS_GATED",
      "commercial_use_requires_rights_review": true
    },
    {
      "source_id": "maritime_weather",
      "kind": "weather_source_family",
      "provider": "OFFICIAL_AND_SPECIALIZED_WEATHER_SOURCES",
      "role": ["WIND", "WAVES", "VISIBILITY", "PRECIPITATION", "STORM_RISK", "PORT_OPERATION_IMPACT"],
      "collection_mode": "API_OR_OFFICIAL_DOWNLOAD",
      "evidence_class": "OBSERVADO_OR_PROJETADO",
      "credential_class": "SOURCE_SPECIFIC",
      "raw_required": true,
      "runtime_status": "DATA_GATED_UNTIL_SOURCE_CONTRACTS_ARE_DEFINED",
      "operational_restriction_claim_allowed": false
    },
    {
      "source_id": "authorized_hydrography",
      "kind": "hydrographic_source_family",
      "provider": "AUTHORIZED_HYDROGRAPHIC_AUTHORITIES",
      "role": ["CHANNEL", "BATHYMETRY_REFERENCE", "NAVIGATION_CONTEXT", "GEOSPATIAL_QA"],
      "collection_mode": "AUTHORIZED_DOWNLOAD_OR_LICENSED_FEED",
      "evidence_class": "OBSERVADO",
      "credential_class": "LICENSE_OR_AUTHORIZATION_WHEN_REQUIRED",
      "raw_required": true,
      "runtime_status": "RIGHTS_GATED",
      "commercial_use_requires_rights_review": true
    },
    {
      "source_id": "port_geofences",
      "kind": "governed_derived_geometry",
      "provider": "AGROLOG_FROM_AUTHORIZED_EVIDENCE",
      "role": ["APPROACH", "PORT_AREA", "ANCHORAGE", "CHANNEL", "BERTH", "TERMINAL"],
      "collection_mode": "VALIDATED_DERIVATION",
      "evidence_class": "INFERIDO_WITH_PROVENANCE",
      "credential_class": "NONE",
      "raw_required": true,
      "runtime_status": "GEOFENCE_VALIDATED_GATE",
      "registry_ref": "contracts/maritime_geofences.v1.json"
    }
  ]
}
