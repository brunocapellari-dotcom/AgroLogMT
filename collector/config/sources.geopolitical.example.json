      "group": "radar",
      "method": "http_env_query",
      "enabled": false,
      "url": "https://api.reliefweb.int/v2/reports?profile=list&preset=latest&limit=100&query%5Bvalue%5D=conflict%20war%20hostilities%20displacement",
      "expected_frequency": "hourly",
      "file_extension": "json",
      "evidence_class": "observado",
      "options": {
        "parser": "reliefweb",
