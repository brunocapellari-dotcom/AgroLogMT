          {"filter": "ncm", "values": [10059010]},
          {"filter": "state", "values": [52]}
        ],
        "details": ["ncm", "state", "country", "via", "urf"],
        "metrics": ["metricFOB", "metricKG"],
        "timeout_seconds": 120
      },
      "notes": "Preparado/gated. Milho em grão, exceto para semeadura. Ativar somente após canário live específico; semente 10051000 permanece fluxo separado."
    },
    {
