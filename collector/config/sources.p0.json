    {
      "source_id": "mdic_comexstat_fertilizantes_core_mt_import_api",
      "name": "MDIC/SECEX ComexStat API - importação fertilizantes core MT",
      "group": "dados",
      "method": "comexstat_api",
      "enabled": false,
      "expected_frequency": "monthly",
      "file_extension": "json",
      "evidence_class": "observado",
      "options": {
        "module": "general",
        "period_mode": "latest_complete_month",
        "flow": "import",
