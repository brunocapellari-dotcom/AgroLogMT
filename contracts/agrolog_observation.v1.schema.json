{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrolog.local/contracts/agrolog_observation.v1.schema.json",
  "title": "AgroLog canonical observation metadata",
  "type": "object",
  "required": [
    "source_id",
    "data_referencia",
    "data_coleta",
    "competencia",
    "evidence_class"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": ["string", "null"]},
    "claim_id": {"type": ["string", "null"]},
    "data_referencia": {"type": "string", "format": "date"},
    "data_publicacao": {"type": ["string", "null"], "format": "date-time"},
    "data_coleta": {"type": "string", "format": "date-time"},
    "competencia": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "evidence_class": {
      "type": "string",
      "enum": ["OBSERVADO", "ESTIMADO", "PROJETADO", "INFERIDO", "INFORMADO", "DERIVADO_DE_OBSERVADO"]
    },
    "source_quality": {"type": ["string", "null"]},
    "claim_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "quality_flags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_hash": {"type": ["string", "null"]},
    "methodology_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}