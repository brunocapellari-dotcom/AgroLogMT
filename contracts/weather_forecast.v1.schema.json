{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrolog.local/contracts/weather_forecast.v1.schema.json",
  "title": "AgroLog weather forecast observation",
  "type": "object",
  "required": [
    "source_id",
    "geo_id",
    "model_cycle_at",
    "valid_at",
    "lead_hours",
    "variable",
    "value",
    "unit",
    "data_referencia",
    "data_publicacao",
    "data_coleta",
    "competencia",
    "evidence_class"
  ],
  "properties": {
    "source_id": {"type": "string"},
    "geo_id": {"type": "string"},
    "model_cycle_at": {"type": "string", "format": "date-time"},
    "valid_at": {"type": "string", "format": "date-time"},
    "lead_hours": {"type": "integer", "minimum": 0},
    "variable": {"type": "string"},
    "value": {"type": "number"},
    "unit": {"type": "string"},
    "data_referencia": {"type": "string", "format": "date"},
    "data_publicacao": {"type": "string", "format": "date-time"},
    "data_coleta": {"type": "string", "format": "date-time"},
    "competencia": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "evidence_class": {"const": "PROJETADO"}
  },
  "additionalProperties": false
}