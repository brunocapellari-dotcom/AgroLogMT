{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrolog.local/contracts/earth_observation_asset.v1.schema.json",
  "title": "AgroLog Earth Observation Asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_id",
    "provider",
    "discovery_method",
    "collection_id",
    "item_id",
    "asset_key",
    "asset_href",
    "media_type",
    "acquisition_start",
    "acquisition_end",
    "data_referencia",
    "data_publicacao",
    "data_coleta",
    "competencia",
    "geometry_ref",
    "bands",
    "license",
    "evidence_class",
    "raw_artifact_ref",
    "source_url"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "discovery_method": {
      "enum": [
        "STAC",
        "EARTHDATA_CMR",
        "OFFICIAL_API",
        "OFFICIAL_FILE"
      ]
    },
    "stac_api_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_key": {
      "type": "string",
      "minLength": 1
    },
    "asset_href": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "acquisition_start": {
      "type": "string",
      "format": "date-time"
    },
    "acquisition_end": {
      "type": "string",
      "format": "date-time"
    },
    "data_referencia": {
      "type": "string",
      "minLength": 1
    },
    "data_publicacao": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_coleta": {
      "type": "string",
      "minLength": 1
    },
    "competencia": {
      "type": [
        "string",
        "null"
      ]
    },
    "geometry_ref": {
      "type": "string",
      "minLength": 1
    },
    "bbox": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 6
    },
    "crs": {
      "type": [
        "string",
        "null"
      ]
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "common_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "center_wavelength": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cloud_cover_pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "spatial_resolution_m": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "license_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_class": {
      "enum": [
        "observado",
        "estimado",
        "inferido"
      ]
    },
    "raw_artifact_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "checksum_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "processing_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "processing_baseline": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes_observation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
