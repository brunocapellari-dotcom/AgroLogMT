{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrologmt.local/contracts/canonical_record_metadata.schema.json",
  "title": "AgroLog MT Canonical Record Metadata v1.2",
  "description": "Envelope minimo de proveniencia, temporalidade, evidencia e qualidade que tabelas canonicas devem preservar. O payload de dominio estende este contrato.",
  "type": "object",
  "required": ["source_id", "data_referencia", "data_coleta", "competencia", "evidence_class", "source_hash", "ingestion_run_id"],
  "properties": {
    "record_id": {"type": ["string", "null"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": ["string", "null"]},
    "dataset_id": {"type": ["string", "null"]},
    "domain_id": {"type": ["string", "null"]},
    "entity_type": {"type": ["string", "null"]},
    "metric_id": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "geo_level": {"type": ["string", "null"]},
    "geo_id": {"type": ["string", "null"]},
    "data_referencia": {"type": "string", "format": "date"},
    "data_publicacao": {"type": ["string", "null"], "format": "date-time"},
    "data_coleta": {"type": "string", "format": "date-time"},
    "data_disponibilidade": {"type": ["string", "null"], "format": "date-time"},
    "availability_verified": {"type": "boolean", "default": false},
    "availability_basis": {
      "type": ["string", "null"],
      "enum": [null, "publication_metadata", "official_page_timestamp", "archive_timestamp", "runtime_collection"]
    },
    "competencia": {"type": "string", "minLength": 1},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "evidence_class": {
      "type": "string",
      "enum": ["observado", "inferido", "estimado", "projetado", "sinal_qualitativo", "negociado_autorizado"]
    },
    "evidence_subtype": {"type": ["string", "null"]},
    "revision_number": {"type": ["integer", "null"], "minimum": 0},
    "methodology_id": {"type": ["string", "null"]},
    "quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "raw_artifact_ref": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "source_hash": {"type": "string", "minLength": 1},
    "collector_version": {"type": ["string", "null"]},
    "parser_version": {"type": ["string", "null"]},
    "transformation_version": {"type": ["string", "null"]},
    "ingestion_run_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
