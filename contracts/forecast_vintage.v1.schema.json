{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrolog.local/contracts/forecast_vintage.v1.schema.json",
  "title": "AgroLog Forecast Vintage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecast_id", "forecast_type", "target", "scope", "issued_at",
    "target_start", "target_end", "horizon", "point_forecast",
    "model_id", "model_version", "training_cutoff", "feature_cutoff",
    "vintage_id", "data_coleta", "evidence_class", "status"
  ],
  "properties": {
    "forecast_id": {"type":"string","minLength":1},
    "forecast_type": {"enum":["production","yield","weather","price","stocks","exports","freight","eta","congestion"]},
    "target": {"type":"string","minLength":1},
    "scope": {"type":"string","minLength":1},
    "commodity": {"type":["string","null"]},
    "issued_at": {"type":"string","format":"date-time"},
    "target_start": {"type":"string","minLength":1},
    "target_end": {"type":"string","minLength":1},
    "horizon": {"type":"string","minLength":1},
    "point_forecast": {"type":["number","null"]},
    "lower_bound": {"type":["number","null"]},
    "upper_bound": {"type":["number","null"]},
    "interval_probability": {"type":["number","null"],"minimum":0,"maximum":1},
    "unit": {"type":["string","null"]},
    "model_id": {"type":"string","minLength":1},
    "model_version": {"type":"string","minLength":1},
    "training_cutoff": {"type":"string","minLength":1},
    "feature_cutoff": {"type":"string","minLength":1},
    "vintage_id": {"type":"string","minLength":1},
    "feature_vintage_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "data_referencia": {"type":["string","null"]},
    "data_publicacao": {"type":["string","null"]},
    "data_coleta": {"type":"string","minLength":1},
    "competencia": {"type":["string","null"]},
    "evidence_class": {"const":"projetado"},
    "status": {"enum":["DRAFT","SHADOW","PROMOTED","SUPERSEDED","INVALIDATED"]},
    "observed_outcome": {"type":["number","null"]},
    "observed_outcome_at": {"type":["string","null"]},
    "error_metrics": {"type":"object"},
    "backtest_ref": {"type":["string","null"]},
    "audit_ref": {"type":["string","null"]}
  }
}
